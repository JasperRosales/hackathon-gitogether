# AMD Cloud credentials for the AI classification service.
# Copy these into a local .env file (never commit real keys).

# API key issued by AMD Cloud. Leave unset until you have it.
VITE_AMD_CLOUD_API_KEY=

# Base URL for the OpenAI-compatible endpoint.
# Leave blank to use the built-in same-origin dev proxy at /amd-cloud/v1,
# which forwards to https://developer.amd.com.cn/radeon (the AMD Cloud
# endpoint does not send CORS headers, so a direct browser call is blocked).
# Only set a direct URL here if that host allows browser CORS.
VITE_AMD_CLOUD_BASE_URL=

# Model name served by AMD Cloud (optional, defaults to DeepSeek-V4-Flash-Vision-Exp).
# DeepSeek-V4-Flash-Vision-Exp is fast at both vision and text. Qwen3.8-Flash-Next
# also works but is much slower (20-90s per request), so allow longer timeouts.
VITE_AMD_CLOUD_MODEL=
