# AMD Cloud credentials for the AI classification service.
# Copy these into a local .env file (never commit real keys).

# API key issued by AMD Cloud. Leave unset until you have it.
VITE_AMD_CLOUD_API_KEY=

# OpenAI-compatible base URL, without a trailing slash.
# Example shape: https://<host>/v1
VITE_AMD_CLOUD_BASE_URL=

# Model name served by AMD Cloud (optional, defaults to gpt-oss-120b).
VITE_AMD_CLOUD_MODEL=
