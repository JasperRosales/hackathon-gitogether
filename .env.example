# AI provider credentials. Copy into a local .env file (never commit real keys).

# --- AMD Radeon Cloud / Token Factory: used by the photo (vision) stylist ---
# API key issued by AMD (format rc-...). Also used by the category classifier.
VITE_AMD_CLOUD_API_KEY=

# OpenAI-compatible base URL, without a trailing slash.
# AMD Token Factory: https://developer.amd.com.cn/radeon/api/v1
VITE_AMD_CLOUD_BASE_URL=

# Text model served by AMD Cloud (used by the classifier; optional).
VITE_AMD_CLOUD_MODEL=

# Multimodal (vision) model used by the photo stylist. Required for photo
# analysis; leave unset to disable that feature. e.g. DeepSeek-V4.1-Flash.
VITE_AMD_CLOUD_VISION_MODEL=

# --- Google Gemini: used by the conversational (chat) stylist ---
# API key from Google AI Studio.
VITE_GEMINI_API_KEY=

# Gemini OpenAI-compatible base URL (optional, defaults to
# https://generativelanguage.googleapis.com/v1beta/openai).
VITE_GEMINI_BASE_URL=

# Gemini model (optional, defaults to gemini-2.5-flash).
VITE_GEMINI_MODEL=
